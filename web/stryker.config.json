{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.unit.config.ts"
  },
  "plugins": ["@stryker-mutator/vitest-runner", "../tools/stryker-lingui/ignorer.ts"],
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.stories.tsx",
    "!src/app/main.tsx",
    "!src/shared/api/generated/**"
  ],
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 70
  },
  "ignoreStatic": true,
  "ignorers": ["lingui-macros"]
}
