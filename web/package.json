{
  "name": "web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "gen:api": "orval",
    "build": "pnpm run gen:api && tsc --noEmit && vite build && node ../tools/check-bundle.ts dist",
    "typecheck": "tsc --noEmit",
    "fsd": "steiger ./src",
    "unused": "knip",
    "deps": "depcruise src --config .dependency-cruiser.ts",
    "check": "pnpm run gen:api && pnpm run typecheck && pnpm run fsd && pnpm run unused && pnpm run deps && pnpm run i18n:check && node ../tools/lint-i18n/index.ts && node ../tools/lint-motion/index.ts",
    "test": "vitest run --passWithNoTests",
    "mutate": "stryker run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "i18n:extract": "lingui extract",
    "i18n:check": "lingui check sync && lingui check missing"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@lingui/cli": "^6.10.1",
    "@lingui/format-po": "^6.10.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "orval": "~8.45.0",
    "playwright": "^1.64.1",
    "steiger": "^0.8.0",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  }
}
