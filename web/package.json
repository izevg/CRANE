{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "fsd": "steiger ./src",
    "unused": "knip",
    "deps": "depcruise src --config .dependency-cruiser.ts",
    "check": "pnpm run typecheck && pnpm run fsd && pnpm run unused && pnpm run deps",
    "test": "vitest run --passWithNoTests",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "steiger": "^0.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  }
}
