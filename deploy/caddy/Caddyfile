# TLS: для публичного имени сертификат выдаёт ACME, для localhost — внутренний CA Caddy.
# Обе переменные приходят из environment сервиса caddy, без дефолтов.
{$CRANE_HOST} {
	encode zstd gzip
	# CRANE верит X-Request-Id от доверенных прокси (CRANE_TRUSTED_PROXIES), поэтому
	# клиентский заголовок удаляем: без него CRANE сам выдаёт идентификатор (UUIDv7).
	reverse_proxy crane:{$CRANE_HTTP_PORT} {
		header_up -X-Request-Id
	}
}
