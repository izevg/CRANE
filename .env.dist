# Шаблон окружения для docker-compose.yaml и docker-compose.dev.yaml.
#   cp .env.dist .env && $EDITOR .env
# Все значения живут здесь; в compose-файлах дефолтов нет, пропущенная переменная — ошибка запуска.
# Файл .env в git не попадает.

# ── Образы ───────────────────────────────────────────────
CRANE_IMAGE=crane/crane
CRANE_VERSION=latest
CADDY_IMAGE=caddy:2
POSTGRES_IMAGE=pgvector/pgvector:pg17
VALKEY_IMAGE=valkey/valkey:8
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
TRIVY_IMAGE=aquasec/trivy:latest

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=crane
# Смените перед боевым запуском. Пароль подставляется в URL, поэтому только URL-безопасные символы.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crane
POSTGRES_PORT=5432

# ── CRANE ────────────────────────────────────────────────
# Публичное имя хоста: для публичного имени Caddy сам получит сертификат ACME
CRANE_HOST=localhost
CRANE_HTTP_PORT=8080
# memory | valkey://valkey:6379 (профиль cache)
CRANE_CACHE=memory
# file:///data/blobs | s3://blobs?endpoint=http://seaweedfs:8333 (профиль s3)
CRANE_BLOBS=file:///data/blobs
CRANE_TRIVY_URL=http://trivy:4954
CRANE_CPUS=2
CRANE_MEMORY=1g

# ── Caddy ────────────────────────────────────────────────
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Вспомогательные сервисы ──────────────────────────────
VALKEY_PORT=6379
SEAWEEDFS_S3_PORT=8333
TRIVY_PORT=4954

# ── Только docker-compose.dev.yaml ───────────────────────
# Адрес, на котором dev-сервисы публикуют порты на хосте
DEV_BIND=127.0.0.1
