# Шаблон окружения для deploy/compose/docker-compose.yaml и docker-compose.dev.yaml (запуск из корня: docker compose --project-directory . -f …).
#   cp .env.dist .env && $EDITOR .env
# Все значения живут здесь; в compose-файлах дефолтов нет, пропущенная переменная — ошибка запуска.
# Файл .env в git не попадает.

# ── Образы ───────────────────────────────────────────────
# Формат `тег@sha256:<digest индекса>`: тег нужен человеку, выбирает образ digest мульти-арх индекса.
# Обновление: `docker buildx imagetools inspect <образ:тег>`, взять строку Digest верхнего уровня.
# Требования к PostgreSQL: 17+, pgvector >= 0.8 (образ ниже: PostgreSQL 17.11, pgvector 0.8.7).
# Образ CRANE собирается локально (Dockerfile) и в реестр не публикуется, поэтому его версия не закреплена.
CRANE_IMAGE=crane/crane
CRANE_VERSION=latest
CADDY_IMAGE=caddy:2.11.7@sha256:504a44d7d74bd2bc28a66afc4774912fc21223ca8a67734af1c54ab2f999b489
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm@sha256:ac08538c6f8b9904c33c8224c5e5706dbe760aca29db1d096972b4052c22a75d
VALKEY_IMAGE=valkey/valkey:8.1.11@sha256:8f836008e0986c36adf50da714c7060cf689dbb335f61fe077939d90fa650809
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8
# Для analyzer (поток SecOps): сервис и профиль scan убраны, пока роли analyze в сервере нет.
TRIVY_IMAGE=aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=crane
POSTGRES_DB=crane
POSTGRES_PORT=5432

# ── Секреты ──────────────────────────────────────────────
# Секреты лежат в файлах (пути относительно каталога compose-файла), в окружение не попадают.
# `task secrets:init` создаёт недостающие файлы со случайными значениями и ничего не перезаписывает.
# Права: на Linux файл монтируется с правами хоста, а сервер (uid 65532) и postgres работают не от владельца,
# поэтому файлы 0644 в каталоге 0700 (задача делает это сама). Каталог /secrets/ в .gitignore.
# Если том postgres (crane-dev) был создан со старым паролем из POSTGRES_PASSWORD, один раз выполните
# `docker compose --project-directory . -f deploy/compose/docker-compose.dev.yaml down -v`: пароль в томе не меняется при смене файла.
# Токен доступа (временный статический токен до v0.4.0).
CRANE_TOKEN_SECRET=./secrets/crane_token
# Пароль PostgreSQL.
POSTGRES_PASSWORD_SECRET=./secrets/postgres_password
# URL каталога целиком: postgres://crane:<пароль>@postgres:5432/crane (пароль только из URL-безопасных символов).
CRANE_DATABASE_URL_SECRET=./secrets/database_url
# Только для S3-режима (docker-compose.s3.yaml) и профиля s3 в docker-compose.dev.yaml; без них файлы не читаются.
# Статический ключ S3: crane читает его через AWS_ACCESS_KEY_ID_FILE и AWS_SECRET_ACCESS_KEY_FILE, а SeaweedFS
# собирает из него identities при старте.
S3_ACCESS_KEY_ID_SECRET=./secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_SECRET=./secrets/s3_secret_access_key
# Пароль пользователя crane в Valkey. ACL собирается при старте контейнера из этого файла (политика в compose-файлах).
VALKEY_PASSWORD_SECRET=./secrets/valkey_password
# URL Valkey целиком: valkey://crane:<пароль>@valkey:6379 (пароль только из URL-безопасных символов).
# Нужен override docker-compose.cache.yaml; сервер читает его через CRANE_CACHE_FILE.
CRANE_CACHE_URL_SECRET=./secrets/cache_url

# ── CRANE ────────────────────────────────────────────────
# Публичное имя хоста: для публичного имени Caddy сам получит сертификат ACME
CRANE_HOST=localhost
CRANE_HTTP_PORT=8080
# Имя личности токена: попадает в журнал аудита и access-журнал.
CRANE_TOKEN_PRINCIPAL=crane
# Подсеть сети edge: в ней только caddy и crane. Она же CRANE_TRUSTED_PROXIES (чьему X-Forwarded-For верить).
CRANE_EDGE_SUBNET=172.31.250.0/24
# Резервирование внутренних имён: `формат:шаблон` или `формат:шаблон=uuid-workspace` через запятую,
# например cargo:acme-*,cargo:acme-payments-*=<uuid>. Снятие записи резервирование не отменяет.
CRANE_NAMESPACES=
# Кэш в compose не задаётся: без CRANE_CACHE и CRANE_CACHE_FILE сервер берёт memory. Valkey включается
# override-файлом docker-compose.cache.yaml (в шапке docker-compose.yaml), его адрес с паролем лежит только
# в секрете CRANE_CACHE_URL_SECRET. Пример для `cargo run` с хоста (dev-Valkey, пароль из VALKEY_PASSWORD_SECRET):
# CRANE_CACHE=valkey://crane:<пароль>@127.0.0.1:6379
# Хранилище blob: file:///data/blobs (по умолчанию) или S3 вместо тома:
#   CRANE_BLOBS=s3://<S3_BUCKET>?endpoint=http://seaweedfs:8333&allow_http=true
#   COMPOSE_FILE=deploy/compose/docker-compose.yaml:deploy/compose/docker-compose.s3.yaml
# Бакет в URL должен совпадать с S3_BUCKET: его создаёт seaweedfs-init.
CRANE_BLOBS=file:///data/blobs
S3_BUCKET=blobs
# Будет читать analyzer (поток SecOps); сервер v0.3.0 эту переменную не читает.
CRANE_TRIVY_URL=http://trivy:4954
CRANE_CPUS=2
CRANE_MEMORY=1g

# ── Caddy ────────────────────────────────────────────────
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Вспомогательные сервисы ──────────────────────────────
VALKEY_PORT=6379
# Предел памяти Valkey. Ключи артефактов proxy живут без TTL, поэтому предел обязателен.
# Политика вытеснения allkeys-lru зафиксирована в compose-файлах и не настраивается.
VALKEY_MAXMEMORY=512mb
SEAWEEDFS_S3_PORT=8333
# Для analyzer (поток SecOps), пока не используется.
TRIVY_PORT=4954

# ── Только docker-compose.dev.yaml ───────────────────────
# Адрес, на котором dev-сервисы публикуют порты на хосте
DEV_BIND=127.0.0.1
